# Copy this file to .env.local and fill in the real values (never commit .env.local).
# SMTP account used to send contact-form emails (e.g. the hr@ezify.pk mailbox).
SMTP_HOST=mail.ezify.pk
SMTP_PORT=465
SMTP_USER=hr@ezify.pk
SMTP_PASS=
# Inbox that receives the enquiries (defaults to SMTP_USER if empty)
CONTACT_TO=hr@ezify.pk
